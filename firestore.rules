rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{userId}/historico_estudos/{dayId} {
      // o usuario só pode ler o próprio histórico.
      allow read: if request.auth != null
        && request.auth.uid == userId;

      // valida os dados enviados ao criar ou atualizar.
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && dayId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasAll([
          'tempoTotalSegundos',
          'sessoesConcluidas',
          'ultimaAtualizacao'
        ])
        && request.resource.data.keys().hasOnly([
          'tempoTotalSegundos',
          'sessoesConcluidas',
          'ultimaAtualizacao'
        ])
        && request.resource.data.tempoTotalSegundos is int
        && request.resource.data.tempoTotalSegundos >= 0
        && request.resource.data.sessoesConcluidas is int
        && request.resource.data.sessoesConcluidas >= 0;

      // só o proprietário pode excluir seus registros.
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }
  }
}